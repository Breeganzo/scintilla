# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# Every variable the application reads is listed here. If you add a new one,
# add it here too - this file is the contract for what the app needs to run.

# ---- Django --------------------------------------------------------------
# Generate a fresh one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-before-running
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database ------------------------------------------------------------
# This file is read by python-dotenv, NOT by a shell. Shell substitutions such
# as $(whoami) are never expanded here - write the literal value.
#
# Local (Homebrew Postgres): postgres://<your-macos-username>@localhost:5432/scintilla
#   Homebrew creates a passwordless superuser named after your account.
#   Run `whoami` and paste the result.
# Docker Compose:            postgres://scintilla:scintilla@postgres:5432/scintilla
DATABASE_URL=postgres://scintilla:scintilla@postgres:5432/scintilla

# ---- OpenSearch ----------------------------------------------------------
# Lexical (BM25) retrieval only. Vectors live in Postgres via pgvector; the
# OpenSearch k-NN plugin has no macOS build. See docs/LOCAL_SETUP.md section 3.
# OPENSEARCH_INDEX is an *alias*, not a concrete index: `index_papers --rebuild`
# builds a timestamped index and repoints the alias when it finishes.
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=papers

# ---- Embeddings ----------------------------------------------------------
# BAAI/bge-small-en-v1.5 -> 384 dimensions. Changing the model means changing
# EMBEDDING_DIM, writing a migration for the pgvector column width, and
# re-embedding the whole corpus - the stored vectors are not comparable across
# models. Needs `pip install -r requirements/ml.txt`.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ---- LLM provider --------------------------------------------------------
# Free tier: https://console.groq.com  - the app degrades to search-only
# without this key rather than failing.
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# ---- Ingestion -----------------------------------------------------------
# arXiv asks for no more than one request every 3 seconds. Be a good citizen.
ARXIV_CATEGORIES=hep-ex,hep-th
ARXIV_RATE_LIMIT_SECONDS=3
ARXIV_MAX_RESULTS=3000

# ---- CORS ----------------------------------------------------------------
# Comma-separated allowlist. Never use "*" - see docs/SECURITY.md.
CORS_ALLOWED_ORIGINS=http://localhost:5173
