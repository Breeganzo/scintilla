# ---- Secrets -------------------------------------------------------------
# Never commit real values. .env.example documents the keys instead.
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/

# ---- Django --------------------------------------------------------------
*.log
db.sqlite3
db.sqlite3-journal
/media/
/staticfiles/

# ---- Testing / coverage --------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.ruff_cache/
.mypy_cache/

# ---- Node / frontend -----------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-error.log*

# ---- Machine learning artefacts -----------------------------------------
# Model weights are large and downloadable; they do not belong in git.
*.bin
*.safetensors
*.onnx
.cache/
models/

# ---- Airflow -------------------------------------------------------------
airflow/logs/
airflow/airflow.db
airflow/airflow.cfg
airflow/webserver_config.py

# ---- Data ----------------------------------------------------------------
# Raw harvested data is reproducible from the API, so it is not tracked.
# Fixtures and the golden set ARE tracked - they are the evaluation contract.
data/raw/
data/interim/
!data/fixtures/
!evaluation/golden_set/

# ---- OS / editor ---------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
*.swp
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
